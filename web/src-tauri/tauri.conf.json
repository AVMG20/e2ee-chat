{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "E2EE Chat",
  "version": "0.4.2",
  "identifier": "io.github.avmg20.e2eechat",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "E2EE Chat",
        "width": 1100,
        "height": 740,
        "minWidth": 380,
        "minHeight": 500,
        "resizable": true,
        "create": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ws: wss: http: https: ipc: http://ipc.localhost",
        "img-src": "'self' blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "script-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "End-to-end encrypted chat for your own server",
    "license": "MIT",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1NEYxNjMwOUQ4Mzg2NzIKUldSeWhvT2RNQlpQWmFHRFk5dEE2WnF5dDZ6QWs4S2FEV2kwV081OVRYNGFWaVVMeWF1clRHWGEK",
      "endpoints": [
        "https://github.com/AVMG20/e2ee-chat/releases/latest/download/latest.json"
      ]
    }
  }
}
